# Environment Variables Configuration

# This is an example file showing all available environment variables.
# Copy this file to create your own environment configuration:
#
# For local development:
#   cp .env.example .env.development.local
#
# For production:
#   cp .env.example .env.production.local

# Backend API URL
# Development: http://localhost:8080
# Production: https://poker-tavern.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# WebSocket URL
# Development: ws://localhost:8080
# Production: wss://poker-tavern.onrender.com
VITE_WS_BASE_URL=ws://localhost:8080

# Optional: JIRA API configuration (if using JIRA integration)
VITE_JIRA_API_URL=
VITE_JIRA_API_TOKEN=
