# JIRA OAuth Configuration
# Get these from your Atlassian app at https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=your-client-id-here
JIRA_CLIENT_SECRET=your-client-secret-here

# JIRA Story Points writeback (SAFETY: disabled by default)
# To prevent accidental production updates, write operations are blocked unless enabled.
JIRA_WRITE_ENABLED=false

# Optional: set explicitly to the customfield id used for Story Points, e.g. customfield_10016
# If not set, the backend will attempt to resolve it by name via the JIRA fields API.
JIRA_STORY_POINTS_FIELD_ID=
